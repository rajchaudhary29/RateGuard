{
  "UseInMemoryFallback": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DistributedRateLimiter": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=ratelimitdb;Username=postgres;Password=postgrespassword;"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "ratelimit:",
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 5000,
    "AbortOnConnectFail": false
  },
  "RateLimiting": {
    "DefaultPermitLimit": 10,
    "DefaultWindowSeconds": 60,
    "ApiKeyHeaderName": "X-Api-Key",
    "TrustForwardedHeaders": true,
    "ApiKeyTiers": {
      "key-standard-123": "Standard",
      "key-premium-999": "Premium"
    },
    "TierLimits": {
      "Anonymous": {
        "PermitLimit": 5,
        "WindowSeconds": 10
      },
      "Standard": {
        "PermitLimit": 20,
        "WindowSeconds": 10
      },
      "Premium": {
        "PermitLimit": 100,
        "WindowSeconds": 10
      }
    },
    "EndpointRules": [
      {
        "RuleName": "StrictProductCreation",
        "EndpointPattern": "/api/products",
        "HttpMethod": "POST",
        "PermitLimit": 3,
        "WindowSeconds": 10
      },
      {
        "RuleName": "PublicAuditLogs",
        "EndpointPattern": "/api/audit-logs/*",
        "HttpMethod": "*",
        "PermitLimit": 30,
        "WindowSeconds": 60
      }
    ]
  }
}

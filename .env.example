# ====================================================================
# Distributed Rate-Limiter: Production Environment Configuration
# Copy this file to .env and replace placeholder values before deployment.
# ====================================================================

# ASP.NET Core Runtime Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Storage & Engine Mode (Set to false for real distributed Redis + PostgreSQL)
UseInMemoryFallback=false

# PostgreSQL Connection String (Production Database)
# Format: Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;
ConnectionStrings__PostgreSql=Host=postgres;Port=5432;Database=ratelimitdb;Username=postgres;Password=YOUR_SECURE_POSTGRES_PASSWORD;

# Redis Connection String (Production Cache & Distributed State Store)
# Supports cluster endpoints, SSL, and authentication credentials:
# Format: <host>:<port>,password=<pass>,ssl=True,abortConnect=False
Redis__ConnectionString=redis:6379,abortConnect=False
Redis__KeyPrefix=ratelimit:prod:
Redis__ConnectTimeoutMs=5000
Redis__SyncTimeoutMs=5000

# Rate Limiting Engine Options
RateLimiting__DefaultPermitLimit=10
RateLimiting__DefaultWindowSeconds=60
RateLimiting__ApiKeyHeaderName=X-Api-Key
RateLimiting__TrustForwardedHeaders=true

# API Key Tier Mappings (Production Tokens)
RateLimiting__ApiKeyTiers__partner_standard_abc123=Standard
RateLimiting__ApiKeyTiers__enterprise_client_xyz999=Premium

# PostgreSQL Schema Initialization Flag
# Set to false in multi-replica production (run scripts/init-db.sql via CI/CD instead)
ApplyMigrationsOnStartup=false
